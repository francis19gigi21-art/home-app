  "typography": {
    "family": "system geometric sans (SF Pro / Roboto default)",
    "metric": { "size": 56, "weight": "300", "letterSpacing": -2 },
    "heading": { "size": 30, "weight": "600", "letterSpacing": -0.5 },
    "sectionTitle": { "size": 20, "weight": "600" },
    "cardLabel": { "size": 13, "weight": "500" },
    "body": { "size": 15, "weight": "400" }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radius_tokens": { "sm": 16, "md": 24, "lg": 28, "xl": 32, "pill": 999 },
  "rules": [
    "large rounded cards 24-36px, no harsh shadows, subtle border or tonal separation",
    "pill filters in one horizontal scroller, active = solid black, 36pt chips",
    "one blurred gradient hero per section max",
    "status shown in words as well as color",
    "44px minimum tap targets",
    "floating black pill bottom nav with larger circular + in the middle",
    "preserve whitespace over density"
  ]
}
